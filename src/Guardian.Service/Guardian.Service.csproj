<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Guardian.Service</RootNamespace>
    <AssemblyName>GuardianSvc</AssemblyName>
    <OutputType>Exe</OutputType>
    <UserSecretsId>guardian-svc</UserSecretsId>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Guardian.Contracts/Guardian.Contracts.csproj" />
    <ProjectReference Include="../Guardian.Core/Guardian.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.8" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Everything under wwwroot ships inside the binary: no files to tamper with, no Node build, no CDN. -->
    <EmbeddedResource Include="wwwroot/**/*" />
    <EmbeddedResource Include="../../lists/defaults.yaml" LogicalName="lists.defaults.yaml" />
    <EmbeddedResource Include="../../lists/sources.txt" LogicalName="lists.sources.txt" />
    <EmbeddedResource Include="../../lists/*.txt" Exclude="../../lists/sources.txt" LogicalName="lists.%(Filename)%(Extension)" />
    <Content Include="Pages/**/*.cshtml" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
