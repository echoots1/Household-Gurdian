<?xml version="1.0" encoding="UTF-8"?>
<!--
  HKLM policy keys (removed automatically when the component is uninstalled):
    - Chrome/Edge ExtensionInstallForcelist + ExtensionInstallAllowlist for the packed Guardian extension
    - Incognito / InPrivate disabled
    - Run key so GuardianTray.exe starts for every account (the service only records the monitored one)
  $(var.ExtensionId) is the 32-char id printed by tools/CrxPack.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="RegistryComponents" Directory="INSTALLFOLDER">

      <Component Id="ChromePolicy" Guid="A1B2C3D4-0001-4A5B-8C9D-E0F1A2B3C4D5">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist">
          <RegistryValue Name="1" Type="string" Value="$(var.ExtensionId);http://127.0.0.1:47130/ext/update.xml" KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\Google\Chrome\ExtensionInstallAllowlist">
          <RegistryValue Name="1" Type="string" Value="$(var.ExtensionId)" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\Google\Chrome">
          <RegistryValue Name="IncognitoModeAvailability" Type="integer" Value="1" />
        </RegistryKey>
      </Component>

      <Component Id="EdgePolicy" Guid="A1B2C3D4-0002-4A5B-8C9D-E0F1A2B3C4D5">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist">
          <RegistryValue Name="1" Type="string" Value="$(var.ExtensionId);http://127.0.0.1:47130/ext/update.xml" KeyPath="yes" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallAllowlist">
          <RegistryValue Name="1" Type="string" Value="$(var.ExtensionId)" />
        </RegistryKey>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\Microsoft\Edge">
          <RegistryValue Name="InPrivateModeAvailability" Type="integer" Value="1" />
        </RegistryKey>
      </Component>

      <Component Id="TrayRunKey" Guid="A1B2C3D4-0003-4A5B-8C9D-E0F1A2B3C4D5">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run">
          <RegistryValue Name="GuardianTray" Type="string" Value="&quot;[INSTALLFOLDER]GuardianTray.exe&quot;" KeyPath="yes" />
        </RegistryKey>
      </Component>

      <!-- Where we are, for the service/tray and for support. -->
      <Component Id="InstallInfo" Guid="A1B2C3D4-0004-4A5B-8C9D-E0F1A2B3C4D5">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Guardian">
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          <RegistryValue Name="Version" Type="string" Value="$(var.Version)" />
          <RegistryValue Name="ExtensionId" Type="string" Value="$(var.ExtensionId)" />
        </RegistryKey>
      </Component>

    </ComponentGroup>
  </Fragment>
</Wix>
