{
  "manifest_version": 3,
  "name": "Guardian",
  "description": "Reports the active site's domain and title to the Guardian service on this computer. Nothing else.",
  "version": "1.0.0",
  "update_url": "http://127.0.0.1:47130/ext/update.xml",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Guardian",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["tabs", "idle", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47130/*"]
}
